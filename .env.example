# Devin API credentials — generate at https://app.devin.ai/settings/api-keys
DEVIN_API_KEY=cog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEVIN_ORG_ID=org-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: name of a Devin-side secret (Settings → Secrets) holding a GitHub PAT
# for Devin to push branches. Leave EMPTY if you're using Devin's GitHub Integration.
DEVIN_GITHUB_SECRET_NAME=

# Per-session ACU ceiling (1 ACU ≈ $2.25). 20 ≈ $45 ceiling per session.
MAX_ACU_LIMIT=20

# Polling interval and per-session timeout.
POLL_INTERVAL_SECONDS=30
SESSION_TIMEOUT_MINUTES=60
